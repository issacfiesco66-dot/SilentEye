# ── Base de datos ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silenteye

# ── Autenticación ──
# JWT (OBLIGATORIO, mín. 32 caracteres)
JWT_SECRET=change_this_to_a_very_secure_random_string_min_32_chars
# JWT_EXPIRES_IN=24h

# ── SMTP (email OTP + notificaciones) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=tu_correo@gmail.com

# ── CORS (producción) ──
# CORS_ORIGINS=https://tu-frontend.vercel.app

# ── Puertos ──
TCP_PORT=5000
HTTP_PORT=3001

# ── Teltonika GPS ──
# true = aceptar cualquier IMEI (pruebas). false = solo IMEIs registrados.
TELTONIKA_SKIP_WHITELIST=true

# ── Rate limiting ──
# RATE_LIMIT_MAX=100

# ── Alertas ──
# Radio (metros) para notificar helpers cercanos (default: 2000 = 2 km)
# PANIC_ALERT_RADIUS_M=2000

# ── Migraciones ──
# Secreto para ejecutar migraciones vía POST /api/setup/migrate
# MIGRATE_SECRET=change_this_secret
