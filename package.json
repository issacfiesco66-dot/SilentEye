{
  "name": "silenteye",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de seguridad vehicular con GPS Teltonika y botón de pánico ciudadano",
  "workspaces": ["backend", "frontend", "simulator"],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:simulator": "npm run start -w simulator",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "build": "npx tsc -p backend && npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.2"
  }
}
